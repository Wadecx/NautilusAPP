{
  "expo": {
    "name": "Nautilus",
    "slug": "nautlius",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nautilus",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F2E8D0",
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F2E8D0",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "Nautilus",
      "shortName": "Nautilus",
      "lang": "fr",
      "themeColor": "#F2E8D0",
      "backgroundColor": "#F2E8D0"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2E8D0",
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#17130E",
            "image": "./assets/images/icon.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
